# Production environment contract — Spec 006 (scaffold for T002).
# Required variables enumerated and validated by T008/T009.

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
BACKEND_LOG_LEVEL=INFO
BACKEND_DATA_DIR=/var/lib/dynamic-dashboard/data
BACKEND_LOG_DIR=/var/log/dynamic-dashboard
METADATA_DB_PATH=/var/lib/dynamic-dashboard/metadata.sqlite

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_BACKEND_URL=http://backend:8000
DASHBOARD_LOG_LEVEL=INFO

# Builder (static asset server)
BUILDER_HOST=0.0.0.0
BUILDER_PORT=3000

# Backup
BACKUP_DIR=/var/backups/dynamic-dashboard
BACKUP_EXTERNAL_DIR=./data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON=0 2 * * *

# Deployment metadata
DEPLOYMENT_BUNDLE_ID=
DEPLOYMENT_RELEASE_VERSION=
COMPOSE_REVISION=
