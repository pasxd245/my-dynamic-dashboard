{
  "name": "my-dynamic-dashboard",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "md:lint": "markdownlint-cli2",
    "md:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "dev:local:up": "bash scripts/dev/stack.sh local-up",
    "dev:local:down": "bash scripts/dev/stack.sh local-down",
    "dev:docker:up": "bash scripts/dev/stack.sh docker-up",
    "dev:docker:down": "bash scripts/dev/stack.sh docker-down",
    "dev:stop": "bash scripts/dev/stack.sh stop-all",
    "dev:status": "bash scripts/dev/stack.sh status",
    "prod:validate": "bash scripts/ops/validate-production-config.sh"
  },
  "keywords": [],
  "author": "pasxd245",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@nci-gis/js-tmpl": "^0.1.0",
    "a2scaffold": "^0.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3"
  }
}
