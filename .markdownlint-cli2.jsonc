{
  "config": {
    "default": true,
    "MD013": false,
    "MD041": false,
    "MD033": false,
    "MD001": false,
    "MD003": false,
    "MD036": false,
    "MD040": false,
    "MD060": false,
    "MD024": { "siblings_only": true },
    // Emphasis/strong STYLE is owned solely by prettier (which
    // .lintstagedrc.json runs first, and whose markdown style is not
    // configurable: `_italic_` + `**strong**`). Disable markdownlint's
    // competing style rules so the two fixers can't fight — the
    // default "consistent" setting flip-flopped against prettier on
    // every commit / on-save and churned the .md files. (Also avoids
    // markdownlint --fix mangling underscore identifiers like
    // `IS_NODE` when forced to rewrite emphasis out of order.)
    "MD049": false,
    "MD050": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".venv/**",
    "**/.venv/**",
    "venv/**",
    "**/venv/**",
    ".git/**",
    ".code-review-graph/**",
    "dist/**",
    "out/**",
    ".husky/_/**",
    "tmp/**",
    "temp/**",
    "LICENSE",
    ".agents/orchestrators/*/runs/**",
    ".agents/tmp/**",
    ".agents/temp/**"
  ]
}
