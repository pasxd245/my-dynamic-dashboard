# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
!*.env.hbs

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Python
venv/
.venv/
.venv-*/
**/.venv/
__pycache__/
*.pyc
*.pyo

# App data
data/
# R30: `data/` above catches js-tmpl templates that live under
# `workspace/config/backend/data/...` (template dir mirrors the
# rendered tree). Un-ignore the template path explicitly so the
# .hbs files ship with the repo.
!workspace/config/**/data/
!workspace/config/**/data/**

# others
tmp/
temp/
.DS_Store
Thumbs.db
.idea/
# .vscode/
*.swp
# Added by code-review-graph
.code-review-graph/

# Generated by hatch-vcs for backend package builds
workspace/apps/backend/app/_version.py

# R16: backend runtime data — SQLite metadata + uploaded file trees
workspace/apps/backend/data/

# R27: js-tmpl-generated config artifacts (rendered from workspace/values.yaml
# + workspace/config/*.hbs). Run `pnpm config:render` to regenerate.
# (workspace/apps/builder/.env is already covered by the .env line above.)
workspace/apps/builder/src/_generated/

# R28: rendered BE config yaml (Layer 1 packaged defaults).
workspace/apps/backend/data/config/

# R29: BE generated constants module.
workspace/apps/backend/app/_generated/
